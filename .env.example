# ===== X AUTOMATION BOT - CONFIGURATION =====
# Copy to .env and fill in your values
# NEVER commit .env to git

# ===== REQUIRED: Anthropic API Key =====
# Used for AI content generation (tweets + replies)
# Get from: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ===== Content Strategy =====
SEARCH_KEYWORDS=AI,python,automation,tech,startup,web development
CONTENT_PILLARS=money:Making money online and financial freedom,building:Building products and side projects,journey:Personal growth and lessons learned
VIRAL_HOOKS=hot_take,question,thread_hook,contrarian,story,tip

# ===== Engagement =====
LIKE_PROBABILITY=0.6
REPLY_PROBABILITY=0.25
FOLLOW_PROBABILITY=0.15
MIN_ENGAGEMENT_SCORE=5

# ===== Rate Limits (Daily) =====
MAX_LIKES_PER_DAY=20
MAX_REPLIES_PER_DAY=5
MAX_FOLLOWS_PER_DAY=10
MAX_UNFOLLOWS_PER_DAY=5
MAX_POSTS_PER_DAY=1

# ===== Rate Limits (Hourly) =====
MAX_LIKES_PER_HOUR=3
MAX_REPLIES_PER_HOUR=1
MAX_FOLLOWS_PER_HOUR=2

# ===== Daily Tweet Window (UTC) =====
DAILY_TWEET_ENABLED=true
DAILY_TWEET_START_HOUR_UTC=10
DAILY_TWEET_END_HOUR_UTC=13

# ===== Unfollow Strategy =====
UNFOLLOW_AFTER_DAYS=7
UNFOLLOW_CHECK_PROBABILITY=0.3

# ===== AI Model =====
AI_MODEL=claude-haiku-4-5-20251001
AI_MAX_TOKENS=150

# ===== Content Moderation =====
BANNED_WORDS=viagra,cialis,pharmacy,mlm,pyramid,dropship

# ===== Browser =====
HEADLESS_MODE=true
STEALTH_MODE=true
BROWSER_TIMEOUT_MS=30000

# ===== Session Behavior =====
ACTIVE_START_HOUR=8
ACTIVE_END_HOUR=23
SESSION_DURATION_MIN=20
SESSION_DURATION_MAX=45
BREAK_DURATION_MIN=30
BREAK_DURATION_MAX=120

# ===== Human Behavior =====
TYPING_WPM=60
MIN_ACTION_DELAY_MS=2000
MAX_ACTION_DELAY_MS=8000

# ===== Debug =====
DEBUG=false
LOG_LEVEL=INFO
ENVIRONMENT=development
